# Little Spoons — environment variables
# Copy to .env.local for local dev, and add the same keys in Vercel
# (Project → Settings → Environment Variables). All must be prefixed VITE_
# so the client build can read them.

# From Supabase: Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Secret families must enter to register. Share it only with invited families.
VITE_SIGNUP_ACCESS_CODE=littlespoons
